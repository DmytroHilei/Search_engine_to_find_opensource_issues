issuewatch

# All build products (objects, dep files, test binaries, the flags stamp) are
# mirrored under build/. Nothing is written into src/ or tests/ any more.
build/

# Per-machine tool settings, and the scratch worktrees agents run in.
.claude/settings.local.json
.claude/worktrees/

# Never commit a token. CLAUDE.md: no secrets in tracked files.
env
*.env

# The personal config, if someone keeps it in the checkout rather than at
# ~/.config/issuewatch/config. It holds the ntfy topic, which is a capability.
# src/config.example is the tracked template and carries only placeholders.
src/config.local.h
/config
/src/config
/issuewatch.conf
