[Unit]
Description=issuewatch - poll GitHub issues, judge with an LLM, push to ntfy
Documentation=file:%h/Search_engine/CONTEXT.md
After=network-online.target

[Service]
Type=oneshot
# Mode 0600. Holds GH_TOKEN, and ANTHROPIC_API_KEY when JUDGE_MODE is not local.
EnvironmentFile=%h/.config/issuewatch/env
# NOTE: OLLAMA_KEEP_ALIVE does NOT belong here. It is read by the `ollama serve`
# process, not by this one -- judge.c sends no keep_alive field -- so setting it
# in this unit does nothing at all. Put it on whatever starts the Ollama server.
ExecStart=%h/Search_engine/issuewatch --oneshot

# The process needs the network, its own state dir, and nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%S/issuewatch
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M
